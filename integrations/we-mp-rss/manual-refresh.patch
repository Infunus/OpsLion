+<template>
+  <a-button @click="visible = true">
+    <template #icon><icon-refresh /></template>
+    {{ running ? '查看采集进度' : '刷新' }}
+  </a-button>
+  <a-modal v-model:visible="visible" title="刷新设置与采集进度" :mask-closable="false">
+    <a-form :model="form" layout="vertical">
+      <a-form-item label="起始页（从 1 开始）">
+        <a-input-number v-model="form.startPage" :min="1" :precision="0" :disabled="running || submitting" />
+      </a-form-item>
+      <a-form-item label="结束页（包含这一页）">
+        <a-input-number v-model="form.endPage" :min="form.startPage || 1" :precision="0" :disabled="running || submitting" />
+      </a-form-item>
+    </a-form>
+    <a-alert v-if="task" :type="taskType" style="margin-bottom: 12px;" role="status">
+      <template #title>{{ taskTitle }}</template>
+      {{ task.message }}
+      <div v-if="task.status !== 'pending'" style="margin-top: 6px;">
+        页码 {{ task.start_page }}–{{ task.end_page }} · 已处理 {{ task.article_count }} 篇文章
+      </div>
+    </a-alert>
+    <a-alert v-if="error" type="error" style="margin-bottom: 12px;">{{ error }}</a-alert>
+    <a-alert v-if="pollError" type="warning">暂时无法读取进度，正在自动重试。{{ pollError }}</a-alert>
+    <a-typography-text type="secondary">任务提交后会持续显示进度；关闭窗口后采集仍会继续。</a-typography-text>
+    <template #footer>
+      <a-button @click="visible = false">关闭</a-button>
+      <a-button type="primary" :loading="submitting" :disabled="running || loadingLatest" @click="startRefresh">
+        {{ running ? '采集中' : '开始采集' }}
+      </a-button>
+    </template>
+  </a-modal>
+</template>
+
+<script setup lang="ts">
+import { computed, onBeforeUnmount, ref, watch } from 'vue'
+import { IconRefresh } from '@arco-design/web-vue/es/icon'
+import { Message } from '@arco-design/web-vue'
+import { UpdateMps, getManualRefreshTask, getLatestManualRefresh, type ManualRefreshTask } from '@/api/subscription'
+
+const props = defineProps<{ mpId: string }>()
+const emit = defineEmits<{ (event: 'complete'): void }>()
+const visible = ref(false)
+const submitting = ref(false)
+const loadingLatest = ref(false)
+const form = ref({ startPage: 1, endPage: 1 })
+const task = ref<ManualRefreshTask | null>(null)
+const error = ref('')
+const pollError = ref('')
+const running = computed(() => task.value?.status === 'pending' || task.value?.status === 'running')
+const taskType = computed(() => task.value?.status === 'success' ? 'success' : running.value ? 'info' : 'error')
+const taskTitle = computed(() => ({ pending: '等待采集', running: '正在采集', success: '采集完成', failed: '采集失败', interrupted: '采集中断' })[task.value?.status || 'pending'])
+let generation = 0
+let timer: ReturnType<typeof setTimeout> | undefined
+
+function errorText(value: unknown) {
+  return typeof value === 'string' ? value : (value as { message?: string })?.message || '请求失败'
+}
+
+function stopPolling() {
+  generation += 1
+  if (timer) clearTimeout(timer)
+}
+
+async function poll(taskId: string, version: number) {
+  try {
+    const next = await getManualRefreshTask(taskId)
+    if (version !== generation) return
+    task.value = next
+    pollError.value = ''
+    if (!running.value) {
+      emit('complete')
+      if (next.status === 'success') Message.success(next.message)
+      else Message.error(next.message)
+      return
+    }
+  } catch (failure) {
+    if (version !== generation) return
+    pollError.value = errorText(failure)
+  }
+  timer = setTimeout(() => poll(taskId, version), 2000)
+}
+
+async function startRefresh() {
+  const { startPage, endPage } = form.value
+  if (!Number.isInteger(startPage) || !Number.isInteger(endPage) || startPage < 1 || endPage < startPage || endPage - startPage >= 1000) {
+    error.value = '请输入有效页码，结束页不能早于起始页，单次最多 1000 页'
+    return
+  }
+  stopPolling()
+  const version = generation
+  submitting.value = true
+  error.value = ''
+  pollError.value = ''
+  try {
+    const next = await UpdateMps(props.mpId, { start_page: startPage - 1, end_page: endPage })
+    if (version !== generation) return
+    if (!next?.task_id) throw new Error('RSS 后端未提供采集进度，请更新 RSS 接入并重启服务')
+    task.value = next
+    Message.info('已提交采集任务')
+    void poll(next.task_id, version)
+  } catch (failure) {
+    if (version === generation) error.value = errorText(failure)
+  } finally {
+    if (version === generation) submitting.value = false
+  }
+}
+
+watch(() => props.mpId, async (mpId) => {
+  stopPolling()
+  const version = generation
+  task.value = null
+  error.value = ''
+  pollError.value = ''
+  submitting.value = false
+  loadingLatest.value = true
+  try {
+    const latest = await getLatestManualRefresh(mpId)
+    if (version !== generation) return
+    task.value = latest
+    if (latest && running.value) void poll(latest.task_id, version)
+  } catch (failure) {
+    if (version === generation) error.value = errorText(failure)
+  } finally {
+    if (version === generation) loadingLatest.value = false
+  }
+}, { immediate: true })
+
+onBeforeUnmount(stopPolling)
+</script>
