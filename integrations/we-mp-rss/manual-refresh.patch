+"""Track manual refreshes while using the original collector and task queue."""
+from copy import deepcopy
+from datetime import datetime, timezone
+import json
+from pathlib import Path
+import threading
+from urllib.parse import urlsplit
+from uuid import uuid4
+
+
+class RefreshFailure(Exception):
+    pass
+
+
+class PageObserver:
+    def __init__(self, progress):
+        self.progress = progress
+        self.pages = 0
+        self.empty = False
+        self.error = None
+
+    def __call__(self, response, *args, **kwargs):
+        url = urlsplit(response.url)
+        if url.hostname != 'mp.weixin.qq.com' or url.path not in (
+            '/cgi-bin/appmsgpublish', '/cgi-bin/appmsg'
+        ):
+            return
+        try:
+            body = response.json()
+            code = body['base_resp']['ret']
+            if code == 200013:
+                self.error = '微信返回 200013：请求频率受限，请稍后重试'
+            elif code == 200003:
+                self.error = '微信返回 200003：授权已过期，请点击刷新授权重新扫码'
+            elif code != 0:
+                self.error = f'微信采集接口返回错误 {code}'
+            else:
+                if 'publish_page' in body:
+                    page = body['publish_page']
+                    page = json.loads(page) if isinstance(page, str) else page
+                    entries = page['publish_list']
+                else:
+                    entries = body['app_msg_list']
+                if not isinstance(entries, list):
+                    raise ValueError()
+                self.error = None  # A successful native retry resolves the earlier response error.
+                self.pages += 1
+                self.empty = self.empty or not entries
+                self.progress(self.pages)
+        except (KeyError, TypeError, ValueError):
+            self.error = '微信未返回有效文章列表，本次采集未完成'
+
+    def verify(self, expected_pages, article_count):
+        if self.error:
+            raise RefreshFailure(self.error)
+        if not self.pages or (self.pages < expected_pages and not self.empty):
+            raise RefreshFailure('采集提前结束，未取得全部文章页，请检查网络或授权状态')
+        if not article_count and not self.empty:
+            raise RefreshFailure('取得了文章页但未能解析文章，本次采集未完成')
+
+
+def timestamp():
+    return datetime.now(timezone.utc).isoformat(timespec='seconds')
+
+
+class ManualRefreshTasks:
+    def __init__(self, state_path, enqueue=None, collect=None):
+        self.path = Path(state_path)
+        self.lock = threading.RLock()
+        self.enqueue = enqueue
+        self.collect = collect or self._collect
+        self.tasks = json.loads(self.path.read_text(encoding='utf-8')) if self.path.exists() else {}
+        for task in self.tasks.values():
+            if task['status'] in ('pending', 'running'):
+                task.update(status='interrupted', message='RSS 服务已重启，采集未完成，请重新刷新', finished_at=timestamp())
+        if self.tasks:
+            self._save()
+
+    def _save(self):
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        temporary = self.path.with_suffix('.tmp')
+        temporary.write_text(json.dumps(self.tasks, ensure_ascii=False), encoding='utf-8')
+        temporary.replace(self.path)
+
+    def update(self, task_id, **values):
+        with self.lock:
+            self.tasks[task_id].update(values)
+            self._save()
+
+    def get(self, task_id):
+        with self.lock:
+            return deepcopy(self.tasks.get(task_id))
+
+    def latest(self, mp_id):
+        with self.lock:
+            return next((deepcopy(task) for task in reversed(list(self.tasks.values()))
+                         if task['mp_id'] == mp_id), None)
+
+    def submit(self, feed, start_page, end_page):
+        # The native API uses a zero-based start and an exclusive end.
+        if not 0 <= start_page < end_page or end_page - start_page > 1000:
+            raise ValueError('页码范围无效：起始页须小于结束页，单次最多采集 1000 页')
+        with self.lock:
+            if any(task['mp_id'] == feed['id'] and task['status'] in ('pending', 'running')
+                   for task in self.tasks.values()):
+                raise ValueError('该公众号已有采集任务，请等待完成')
+            if len(self.tasks) >= 100:
+                for task_id in list(self.tasks):
+                    if self.tasks[task_id]['status'] not in ('pending', 'running'):
+                        del self.tasks[task_id]
+                        break
+                else:
+                    raise ValueError('采集队列已满，请等待已有任务完成')
+            task_id = uuid4().hex
+            self.tasks[task_id] = {
+                'task_id': task_id, 'mp_id': feed['id'], 'mp_name': feed['mp_name'],
+                'status': 'pending', 'message': '已加入采集队列，等待执行',
+                'start_page': start_page + 1, 'end_page': end_page,
+                'current_page': start_page + 1, 'pages_received': 0, 'article_count': 0,
+                'created_at': timestamp(),
+            }
+            self._save()
+            try:
+                if self.enqueue is None:
+                    from core.queue import TaskQueue
+                    enqueue = TaskQueue.add_task
+                else:
+                    enqueue = self.enqueue
+                accepted = enqueue(self.run, task_id, feed, start_page, end_page,
+                                   task_name=f"手动刷新 · {feed['mp_name']} · {task_id[:6]}", max_retries=0)
+                if not accepted:
+                    raise ValueError('采集队列未接受任务，请稍后重试')
+            except Exception:
+                self.update(task_id, status='failed', message='加入采集队列失败，请稍后重试', finished_at=timestamp())
+                raise
+            return self.get(task_id)
+
+    def run(self, task_id, feed, start_page, end_page):
+        self.update(task_id, status='running', started_at=timestamp(), message=f'正在采集第 {start_page + 1} 页')
+        try:
+            self.collect(task_id, feed, start_page, end_page)
+            count = self.get(task_id)['article_count']
+            self.update(task_id, status='success', finished_at=timestamp(),
+                        message=f'采集完成，处理 {count} 篇文章' if count else '采集完成，所选页没有文章或没有新增文章')
+        except Exception as error:
+            message = str(error) if isinstance(error, RefreshFailure) else '采集执行失败，请检查 RSS 服务日志'
+            self.update(task_id, status='failed', message=message, finished_at=timestamp())
+            # The original queue must also record failure instead of success.
+            raise RefreshFailure(message) from None
+
+    def _collect(self, task_id, feed, start_page, end_page):
+        from core.config import cfg
+        from core.wx import WxGather
+        from core.db import DB
+        from core.models.article import Article
+        from jobs.article import UpdateArticle
+
+        engine = WxGather().Model()
+        seen = set()
+
+        def page_received(count):
+            page = start_page + count
+            self.update(task_id, current_page=page, pages_received=count,
+                        message=f'正在处理第 {page} 页，已处理 {len(seen)} 篇文章')
+
+        observer = PageObserver(page_received)
+
+        def save(article):
+            saved = UpdateArticle(article)
+            expected_id = f"{feed['id']}-{article['id']}".replace('MP_WXS_', '')
+            with DB.get_session() as session:
+                stored = session.query(Article.id).filter(
+                    (Article.id == expected_id) | (Article.url == article['url'])
+                ).first()
+            if stored is None:
+                raise RefreshFailure('文章保存失败，本次采集未完成')
+            seen.add(str(article['id']))
+            self.update(task_id, article_count=len(seen),
+                        message=(f'正在处理第 {start_page + observer.pages} 页，已处理 {len(seen)} 篇文章'
+                                 if observer.pages else f'正在处理文章，已处理 {len(seen)} 篇'))
+            return saved
+
+        hooks = engine.session.hooks.setdefault('response', [])
+        hooks.append(observer)
+        try:
+            engine.get_Articles(faker_id=feed['faker_id'], Mps_id=feed['id'], Mps_title=feed['mp_name'],
+                                CallBack=save, start_page=start_page, MaxPage=end_page,
+                                interval=int(cfg.get('interval', 10)))
+            if not getattr(engine, 'response_valid', False):
+                observer.verify(end_page - start_page, len(seen))
+        except Exception as error:
+            if observer.error:
+                raise RefreshFailure(observer.error) from None
+            code = getattr(error, 'code', None)
+            if code in ('missing_cookie', -2012, -2013, -2041, -2010, 401):
+                raise RefreshFailure(f'微信读书授权不可用（{code}），请到微信读书管理中扫码授权') from None
+            if code:
+                raise RefreshFailure(f'原版采集未完成（{code}），请检查采集设置和登录状态') from None
+            raise
+        finally:
+            hooks.remove(observer)
+            engine.session.close()
+
+
+_tasks = None
+_tasks_lock = threading.Lock()
+
+
+def get_manual_refresh_tasks():
+    global _tasks
+    with _tasks_lock:
+        if _tasks is None:
+            _tasks = ManualRefreshTasks(Path('data/manual-refresh-tasks.json'))
+        return _tasks
