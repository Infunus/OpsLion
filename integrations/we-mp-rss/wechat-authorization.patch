+interface QRStatus {
+  state?: 'idle' | 'loading' | 'waiting' | 'success' | 'failed'
+  error?: string
+  login_status?: boolean
+  qr_code?: boolean
+}
+
+interface QRResult extends QRStatus {
+  code: string
+  is_exists?: boolean
+}
+
+const pause = (signal?: AbortSignal) => new Promise<void>((resolve, reject) => {
+  const abort = () => {
+    clearTimeout(timer)
+    signal?.removeEventListener('abort', abort)
+    reject(new DOMException('授权窗口已关闭', 'AbortError'))
+  }
+  const timer = setTimeout(() => {
+    signal?.removeEventListener('abort', abort)
+    resolve()
+  }, 1000)
+  signal?.addEventListener('abort', abort, { once: true })
+  if (signal?.aborted) abort()
+})
+
+const pollQR = async (ready: (status: QRStatus) => boolean, timeout: number, signal?: AbortSignal) => {
+  const deadline = Date.now() + timeout
+  while (Date.now() < deadline) {
+    if (signal?.aborted) throw new DOMException('授权窗口已关闭', 'AbortError')
+    const status = await http.get<unknown, QRStatus>('/wx/auth/qr/status', { signal, timeout: 8000 })
+    if (status.state === 'failed') throw new Error(status.error || '授权失败，请重试')
+    if (ready(status)) return status
+    await pause(signal)
+  }
+  throw new Error('等待授权超时，请重新获取二维码')
+}
+
+export const QRCode = async (signal?: AbortSignal): Promise<QRResult> => {
+  const result = await http.get<unknown, QRResult>('/wx/auth/qr/code', { signal, timeout: 10000 })
+  if (result.state === 'failed') throw new Error(result.error || '授权任务启动失败，请重试')
+  if (!result.code) throw new Error('服务未返回二维码地址，请重试')
+  await pollQR(status => status.qr_code === true || status.login_status === true, 75000, signal)
+  return result
+}
+
+export const checkQRCodeStatus = (signal?: AbortSignal) => pollQR(status => {
+  if (status.login_status) return true
+  if (status.qr_code === false && status.state !== 'loading') {
+    throw new Error('二维码已失效，请重新获取')
+  }
+  return false
+}, 300000, signal)
