{
  "manifest_version": 3,
  "name": "运营狮 · Xiumi Bridge",
  "version": "0.4.1",
  "description": "在 OpsLion 与秀米、公众号成品之间双向传递排版模板和富文本。",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage", "clipboardRead"],
  "host_permissions": [
    "https://xiumi.us/*",
    "https://*.xiumi.us/*",
    "https://v.xiumius.cn/*",
    "https://mp.weixin.qq.com/*",
    "http://127.0.0.1:4319/*"
  ],
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "运营狮 Xiumi Bridge",
    "default_popup": "popup.html"
  }
}
